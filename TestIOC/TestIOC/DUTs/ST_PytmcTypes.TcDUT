<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_PytmcTypes" Id="{b6b1762f-8c9f-44b3-8428-243d291b76e5}">
    <Declaration><![CDATA[TYPE ST_PytmcTypes :
// From https://pcdshub.github.io/pytmc/v2.18.2/pragma_usage.html#data-and-record-types
STRUCT
    {attribute 'pytmc' := 'pv: BOOL'}
    bBool: BOOL;
    {attribute 'pytmc' := 'pv: BYTE'}
    iByte: BYTE;
    {attribute 'pytmc' := 'pv: SINT'}
    iSint: SINT;
    {attribute 'pytmc' := 'pv: USINT'}
    iUsint: USINT;
    {attribute 'pytmc' := 'pv: WORD'}
    iWord: WORD;
    {attribute 'pytmc' := 'pv: INT'}
    iInt: INT;
    {attribute 'pytmc' := 'pv: UINT'}
    iUint: UINT;
    {attribute 'pytmc' := 'pv: ENUM'}
    iEnum: ENUM_Test;
    {attribute 'pytmc' := 'pv: DWORD'}
    iDword: DWORD;
    {attribute 'pytmc' := 'pv: DINT'}
    iDin: DINT;
    {attribute 'pytmc' := 'pv: UDINT'}
    iUdint: UDINT;
    {attribute 'pytmc' := 'pv: REAL'}
    fReal: REAL;
    {attribute 'pytmc' := 'pv: LREAL'}
    fLreal: LREAL;
    {attribute 'pytmc' := 'pv: STRING'}
    sString: STRING;
    {attribute 'pytmc' := 'pv: ARRAY'}
    arrInt: ARRAY[0..99] OF INT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>