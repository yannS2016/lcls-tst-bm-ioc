    '}
    stIncr: ARRAY[1..nInArray] OF ST_PytmcTypes;
    {attribute 'pytmc' :='
        pv: @(PREFIX)SET
        io: io
    '}
    stSet: ARRAY[1..nInArray] OF ST_PytmcTypes;

    timer: TON := (PT := T#2S);
    rand: DRAND;
    idx: UINT;
    mult: LREAL;
	nI : UINT;
END_VAR
VAR PERSISTENT
    {attribute 'pytmc' :='
        pv: @(PREFIX)PERS:PASS0
        io: io
		autosave_pass1: VAL
    '}
