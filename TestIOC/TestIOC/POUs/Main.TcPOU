    <Implementation>
      <ST><![CDATA[
fbMotion01(stMotionStage:=M1);
fbMotion02(stMotionStage:=M2);
fbMotion03(stMotionStage:=M3);
fbMotion04(stMotionStage:=M4);
fbMotion05(stMotionStage:=M5);
fbMotion06(stMotionStage:=M6);
fbMotion07(stMotionStage:=M7);
fbMotion08(stMotionStage:=M8);
fbMotion09(stMotionStage:=M9);
fbMotion10(stMotionStage:=M10);
fbMotion11(stMotionStage:=M11);
fbMotion12(stMotionStage:=M12);
fbMotion13(stMotionStage:=M13);
fbMotion14(stMotionStage:=M14);
fbMotion15(stMotionStage:=M15);
fbMotion16(stMotionStage:=M16);
fbMotion17(stMotionStage:=M17);
fbMotion18(stMotionStage:=M18);
fbMotion19(stMotionStage:=M19);
fbMotion20(stMotionStage:=M20);
fbMotion21(stMotionStage:=M21);
fbMotion22(stMotionStage:=M22);
fbMotion23(stMotionStage:=M23);
fbMotion24(stMotionStage:=M24);
fbMotion25(stMotionStage:=M25);
fbMotion26(stMotionStage:=M26);
fbMotion27(stMotionStage:=M27);
fbMotion28(stMotionStage:=M28);
fbMotion29(stMotionStage:=M29);
fbMotion30(stMotionStage:=M30);

FOR nI := 1 TO nMotAbsAxes BY 1 DO
	fbMotionArr[nI]();
END_FOR

timer(
    IN:=NOT timer.Q
);

IF timer.Q THEN
	FOR nI := 1 TO nInArray BY 1 DO
		// Flip the boolean
		stIncr[nI].bBool := NOT stIncr[nI].bBool;
	
		// Increment the ints
		stIncr[nI].iByte := stIncr[nI].iByte + 1;
		stIncr[nI].iSint := stIncr[nI].iSint + 1;
		stIncr[nI].iUsint := stIncr[nI].iUsint + 1;
		stIncr[nI].iWord := stIncr[nI].iWord + 1;
		stIncr[nI].iInt := stIncr[nI].iInt + 1;
		stIncr[nI].iUint := stIncr[nI].iUint + 1;
		stIncr[nI].iDword := stIncr[nI].iDword + 1;
		stIncr[nI].iDint := stIncr[nI].iDint + 1;
		stIncr[nI].iUdint := stIncr[nI].iUdint + 1;
	
		// Multiply the floats randomly
		rand(Seed:=42);
		IF rand.Num < 0.5 THEN
			mult := rand.Num + 0.5;
		ELSE
			mult := rand.Num * 2;
		END_IF
		IF stIncr[nI].fReal = 0 THEN
			stIncr[nI].fReal := 1;
		ELSIF stIncr[nI].fReal > 99999999.9999 THEN
			stIncr[nI].fReal := 1;
		ELSE
			stIncr[nI].fReal := LREAL_TO_REAL(stIncr[nI].fReal * mult);
		END_IF
		IF stIncr[nI].fLreal = 0 THEN
			stIncr[nI].fLreal := 1;
		ELSIF stIncr[nI].fLreal > 99999999.9999 THEN
			stIncr[nI].fLreal := 1;
		ELSE
			stIncr[nI].fLreal := stIncr[nI].fLreal * mult;
		END_IF
	
		// To the next enum
		CASE stIncr[nI].iEnum OF
			ENUM_Test.zero : stIncr[nI].iEnum := Enum_test.one;
			ENUM_Test.one : stIncr[nI].iEnum := Enum_test.two;
			ENUM_Test.two : stIncr[nI].iEnum := Enum_test.three;
			ENUM_Test.three : stIncr[nI].iEnum := Enum_test.four;
			ENUM_Test.four : stIncr[nI].iEnum := Enum_test.five;
			ENUM_Test.five : stIncr[nI].iEnum := Enum_test.six;
			ENUM_Test.six : stIncr[nI].iEnum := Enum_test.seven;
			ENUM_Test.seven : stIncr[nI].iEnum := Enum_test.zero;
		END_CASE
	
		// I guess we'll just do the letter a a lot
		IF LEN(stIncr[nI].sString) > 39 THEN
			stIncr[nI].sString := '';
		ELSE
			stIncr[nI].sString := CONCAT(stIncr[nI].sString, 'a');
		END_IF
		
		// I guess we'll just do the letter b a lot
		IF LEN(stIncr[nI].sMaxString) > 254 THEN
			stIncr[nI].sMaxString := '';
		ELSE
			stIncr[nI].sMaxString := CONCAT(stIncr[nI].sMaxString, 'b');
		END_IF
	
		// Array, copy value to next and add one in first slot
		FOR idx := 0 TO 98 DO
			stIncr[nI].arrInt[99 - idx] := stIncr[nI].arrInt[98 - idx];
		END_FOR
		stIncr[nI].arrInt[0] := stIncr[nI].arrInt[0] + 1;
	END_FOR
END_IF]]></ST>
    </Implementation>
